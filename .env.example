# Copy this to .env.local and fill in real values: cp .env.example .env.local

# Site URL (used for the Stripe success/cancel redirects)
NEXT_PUBLIC_URL=http://localhost:3000

# Sanity (products and the studio under /admin)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-05
# Token with write access, used by the Stripe webhook to update stock
SANITY_API_WRITE_TOKEN=sk_placeholder

# Stripe (checkout)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend (contact form and order emails)
RESEND_API_KEY=re_placeholder
NOTIFICATION_EMAIL=you@example.com
