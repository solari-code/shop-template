# Copy this to .env.local and fill in real values: cp .env.example .env.local
# No .env file is needed to try the shop: without keys it runs in local mode.

# Shop mode: "local" (offline: local products, test checkout, emails to console)
# or "live" (Sanity, Stripe, Resend). Leave empty to detect it automatically:
# live when the Sanity project/dataset and the Stripe secret key are set, local otherwise.
SHOP_MODE=

# Site URL (used for the Stripe success/cancel redirects)
NEXT_PUBLIC_URL=http://localhost:3000

# Sanity (products and the studio under /admin)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-05
# Token with write access, used by the Stripe webhook to update stock
SANITY_API_WRITE_TOKEN=

# Stripe (checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (contact form and order emails)
RESEND_API_KEY=
NOTIFICATION_EMAIL=
